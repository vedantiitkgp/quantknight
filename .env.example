# ─────────────────────────────────────────────────────────────────
#  Stock Engine — Environment Configuration
#  Copy this file to .env and fill in your real keys
# ─────────────────────────────────────────────────────────────────

# ── Financial Data APIs ──────────────────────────────────────────
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── LLM Providers (at least one required) ────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# https://platform.openai.com/ (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ── HuggingFace Inference API (FinBERT sentiment) ────────────────
# https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here

# ── Notifications ────────────────────────────────────────────────
# Create bot via @BotFather on Telegram, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://engine_admin:yourpassword@localhost:5432/quant_engine

# ── Engine Behaviour ─────────────────────────────────────────────
LLM_PROVIDER=anthropic           # anthropic | openai
UNIVERSE_SIZE=500                # how many stocks to pull from FMP screener
MAX_AGENT_CANDIDATES=15          # how many stocks get the full agent debate
MAX_FINAL_PICKS=10               # final picks sent to Telegram
LOG_LEVEL=INFO
